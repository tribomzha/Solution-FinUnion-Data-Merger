@startuml FinUnion_Intermediate_DFD_L0

title FinUnion Group — DFD Level 0\nПромежуточное состояние через 3 месяца

left to right direction

skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowFontSize 10
skinparam nodesep 40
skinparam ranksep 70

skinparam rectangle {
    RoundCorner 10
    BorderColor #475569
}

skinparam database {
    BorderColor #475569
}

' =========================================================
' Операционные системы FinUnion
' =========================================================

package "FinUnion — операционные системы As-Is" #E8F2FF {
    rectangle "CRM FinUnion\nКлиент, идентификатор клиента,\nобращение клиента" as FUCRM
    rectangle "Core Banking FinUnion\nСчёт, договор, платёж, транзакция,\nпродукт, справочник" as FUCORE
    rectangle "Card Processing FinUnion\nКарта, карточная транзакция,\nкарточный продукт, справочник" as FUCARD
    rectangle "Loan System FinUnion\nКредит, договор, график платежей,\nкредитный продукт, справочник" as FULOAN
}

' =========================================================
' Операционные системы RetailBank
' =========================================================

package "RetailBank — операционные системы As-Is" #FFF0E3 {
    rectangle "CRM RetailBank\nКлиент, идентификатор клиента,\nобращение клиента" as RBCRM
    rectangle "Core Banking RetailBank\nСчёт, договор, платёж, транзакция,\nпродукт, справочник" as RBCORE
    rectangle "Card Processing RetailBank\nКарта, карточная транзакция,\nкарточный продукт, справочник" as RBCARD
    rectangle "Loan System RetailBank\nКредит, договор, график платежей,\nкредитный продукт, справочник" as RBLOAN
}

' =========================================================
' Компоненты промежуточного состояния
' =========================================================

rectangle "Integration Layer\nAPI / events / CDC / batch-адаптеры\nValidate / Enrich\nМаршрутизация и преобразование данных" as INT #EAE4FA

database "MDM Customer Hub\nКлиент, глобальный ID,\nсопоставление локальных ID — crosswalk\nValidate / Enrich / Create / Update / Delete" as MDM #DDF6E7

database "Consolidated DWH\nКлиент, счёт, карта, кредит, договор,\nтранзакция, платёж, продукт,\nобращение клиента, справочник\nValidate / Enrich / Create / Update / Aggregate" as DWH #DBEAFE

database "FU DWH + RB DWH\nСуществующие хранилища As-Is\nИстория и отчётные срезы" as LEGACY #F4F0E9

rectangle "BI\nЕдиная управленческая отчётность\nRead" as BI #F4F4F4

rectangle "DataHub / каталог данных\nСхемы, глоссарий, владельцы,\nlineage и результаты проверок качества\nCreate / Update / Read metadata" as CAT #FCE4EF

rectangle "Регуляторная отчётность\nВнешний потребитель\nсверенных отчётных наборов" as REG #F4F4F4

actor "Data Owner /\nData Steward" as OWNER

' =========================================================
' F01–F02. Клиентские данные и обращения
' =========================================================

FUCRM --> INT : F01 Клиент, идентификатор, обращение\nИзменения Create / Update;\nразрешённый Delete / деактивация

RBCRM --> INT : F02 Клиент, идентификатор, обращение\nИзменения Create / Update;\nразрешённый Delete / деактивация

' =========================================================
' F03. Счета, договоры, платежи и транзакции
' =========================================================

FUCORE --> INT : F03 Счёт, договор, платёж, транзакция;\nлокальный ID клиента, продукт, справочник\nRead изменений Create / Update

RBCORE --> INT : F03 Счёт, договор, платёж, транзакция;\nлокальный ID клиента, продукт, справочник\nRead изменений Create / Update

' =========================================================
' F04. Карты и карточные транзакции
' =========================================================

FUCARD --> INT : F04 Карта, карточная транзакция;\nлокальный ID клиента, продукт, справочник\nRead изменений Create / Update

RBCARD --> INT : F04 Карта, карточная транзакция;\nлокальный ID клиента, продукт, справочник\nRead изменений Create / Update

' =========================================================
' F05. Кредиты и кредитные договоры
' =========================================================

FULOAN --> INT : F05 Кредит, договор, график платежей;\nлокальный ID клиента, продукт, справочник\nRead изменений Create / Update

RBLOAN --> INT : F05 Кредит, договор, график платежей;\nлокальный ID клиента, продукт, справочник\nRead изменений Create / Update

' =========================================================
' F06–F08. Единый клиентский профиль
' =========================================================

INT --> MDM : F06 Клиент и локальные идентификаторы\nValidate / Enrich;\nCreate / Update golden record;\nсогласованный Delete / деактивация

MDM --> INT : F07 Golden record, global_customer_id,\ncrosswalk и статус записи\nRead / публикация изменений

INT --> FUCRM : F08 Глобальный ID,\nразрешённые золотые атрибуты\nEnrich / Update

INT --> RBCRM : F08 Глобальный ID,\nразрешённые золотые атрибуты\nEnrich / Update

' =========================================================
' F09–F11. Консолидация данных в DWH
' =========================================================

INT --> DWH : F09 Счёт, карта, кредит, договор,\nтранзакция, платёж, продукт,\nобращение, справочник\nValidate / Enrich / Create / Update;\nобработка разрешённых удалений

MDM --> DWH : F10 Golden record клиента,\nglobal_customer_id, crosswalk, статус\nRead / Create / Update;\nобработка разрешённых удалений

LEGACY --> INT : F11 Исторические данные и отчётные срезы\nRead / Validate;\nbatch-загрузка через F09

' =========================================================
' F12–F13. Аналитика и регуляторная отчётность
' =========================================================

DWH --> BI : F12 Витрины по клиентам, счетам,\nкартам, кредитам, продуктам и операциям\nAggregate в DWH / Read в BI

DWH --> REG : F13 Закрытые и сверенные\nотчётные наборы\nAggregate / Read / Export

' =========================================================
' F14. Каталог и происхождение данных
' =========================================================

INT ..> CAT : F14 Схемы источников, контракты,\nправила преобразования и lineage\nCreate / Update metadata

MDM ..> CAT : F14 Модель клиента, правила сопоставления,\nвладельцы и результаты Validate\nCreate / Update metadata

DWH ..> CAT : F14 Таблицы, витрины, lineage,\nметрики и результаты Validate\nCreate / Update metadata

CAT ..> OWNER : F14 Метаданные, владельцы,\nпроисхождение данных\nRead metadata

' =========================================================
' F15. Управление качеством данных
' =========================================================

DWH --> OWNER : F15 DQ-инциденты,\nссылки на источник и проблемные записи\nRead / анализ причины

' =========================================================
' Архитектурные пояснения
' =========================================================

note top of INT
    Операционные системы продолжают работать.
    Create / Update финансовых данных
    выполняются в системах-владельцах.

    Integration Layer передаёт изменения,
    проверяет формат и обогащает данные.
    Он не выполняет финансовые операции.
end note

note bottom of MDM
    Глобальный ID не заменяет локальные ID.

    Crosswalk:
    система-источник + локальный ID
    -> global_customer_id.

    Обращения, счета, карты и кредиты
    не становятся мастер-данными MDM.

    Для MVP доменные записи связываются
    с клиентом через crosswalk без
    обязательной модификации всех OLTP.
end note

note bottom of DWH
    Aggregate выполняется в DWH.
    BI не обращается к OLTP для аналитики.
    DWH не изменяет операционные системы.

    История и текущие изменения
    сверяются и дедуплицируются
    по источнику, ключу и версии записи.

    Ошибки исправляются владельцем
    в мастер-системе; исправления
    повторно поступают через интеграцию.
end note

note bottom of CAT
    Каталог хранит метаданные,
    а не копии клиентских
    и финансовых записей.
end note

legend bottom
    |= Действие |= Значение |
    | Create | Создание записи в системе-владельце или её представления у получателя |
    | Read | Чтение данных, изменений или готовой витрины |
    | Update | Изменение записи с сохранением необходимой истории |
    | Delete | Только согласованное удаление или деактивация допустимых данных |
    | Enrich | Добавление глобального ID и сопоставленных справочных кодов |
    | Validate | Проверка схемы, обязательности, связей и согласованности данных |
    | Aggregate | Расчёт показателей и отчётных наборов в DWH |

    Сплошные стрелки — бизнес-данные и DQ-инциденты.
    Пунктирные стрелки — метаданные.

    Финансовые факты в рамках этой схемы не удаляются.
    Корректировки выполняются с сохранением истории и аудита.
    Удаление дубля клиента не удаляет связанные финансовые факты.

    Продукты и справочники пока остаются в доменных системах.
    В Integration Layer применяются согласованные таблицы соответствий.
endlegend

@enduml