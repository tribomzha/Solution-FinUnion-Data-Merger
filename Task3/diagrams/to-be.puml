@startuml FinUnion_Data_ToBe

skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
left to right direction

title FinUnion Group — целевая архитектура данных через 12 месяцев

package "Операционный контур (OLTP)" {
  component "FU CRM / RB CRM\nКлиент: локальный профиль\nОбращение клиента\nСогласие" as CRM
  component "FU Core / RB Core\nКлиент: локальный профиль\nСчёт\nДоговор: некредитные договоры\nТранзакция: учётная запись\nПлатёжное поручение" as CORE
  component "FU Cards / RB Cards\nКарточный процессинг\nТранзакция: карточные события\nИспользование Тарифа" as CARDS
  component "FU Loans / RB Loans\nДоговор: кредитные договоры\nГрафик платежей\nПДН\nПСК\nИспользование Кредитного продукта,\nТарифа и Дополнительной услуги" as LOANS
}

package "Управление мастер-данными (MDM)" {
  component "Customer MDM\nКлиент: золотая запись\nЕдиный идентификатор\nСопоставление исходных записей" as MDM
  component "Product / Reference MDM\nКредитный продукт\nТариф\nДополнительная услуга\nСправочник" as RDM
}

package "Интеграционный слой" {
  component "API Gateway\nДоступ к операционным API" as GW
  component "Интеграционные сервисы\nМаршрутизация и преобразование контрактов\nСопоставление идентификаторов" as INT
  component "CDC-коннекторы\nЗахват изменений источников" as CDC
  queue "Apache Kafka\nСобытия бизнес-сущностей\nПотоки изменений данных" as KAFKA
}

package "Аналитический контур (OLAP)" {
  database "Data Lakehouse\nИсходные данные и история 14 сущностей\nСобытия и версии записей\nПодготовленные наборы данных" as LAKE
  database "Корпоративный DWH\nЕдиный загрузочный слой\nПроверенные данные 14 сущностей\nФинансовые и управленческие витрины" as DWH
  component "BI / Семантический слой\nКлиенты и обращения\nСчета и договоры\nТранзакции и платёжные поручения\nКредитные продукты, тарифы и услуги\nГрафики платежей, ПДН и ПСК" as BI
}

package "Сервисы платформы данных" {
  component "Apache Airflow\nОркестрация пакетных загрузок\nПреобразования и повторные расчёты" as AIRFLOW
  component "Контроль качества данных\nПроверки связности и полноты\nДедупликация и финансовые сверки" as DQ
  component "DataHub\nКаталог 14 бизнес-сущностей\nСвязь с физическими наборами данных\nВладельцы и происхождение данных" as HUB
}

GW --> INT : Синхронные запросы\nпо бизнес-сущностям

CRM <--> INT : Клиент, Обращение клиента, Согласие:\nчтение и изменение через API
CORE <--> INT : Клиент, Счёт, Договор, Транзакция,\nПлатёжное поручение: операционные API
CARDS <--> INT : Запросы о карточных транзакциях\nи получение тарифов
LOANS <--> INT : Договор, График платежей, ПДН, ПСК:\nоперационные API; получение продуктов и условий

INT <--> MDM : Клиент: сопоставление исходных записей\nи получение золотой записи
INT <--> RDM : Кредитный продукт, Тариф,\nДополнительная услуга, Справочник:\nчтение и согласованные изменения

CRM --> CDC : Изменения Клиента,\nОбращения клиента и Согласия
CORE --> CDC : Изменения Клиента, Счёта, Договора,\nТранзакции и Платёжного поручения
CARDS --> CDC : Изменения карточных транзакций
LOANS --> CDC : Изменения Договора,\nГрафика платежей, ПДН и ПСК

CDC --> KAFKA : Изменения записей\nс идентификаторами источников
INT --> KAFKA : Доменные события\nпо бизнес-сущностям
MDM --> KAFKA : Изменения золотой записи Клиента\nи сопоставлений идентификаторов
RDM --> KAFKA : Изменения Кредитного продукта, Тарифа,\nДополнительной услуги и Справочника
KAFKA --> INT : Распространение изменений мастер-данных\nв подписанные операционные системы

KAFKA --> LAKE : Исходные изменения и события\nпо 14 бизнес-сущностям
KAFKA --> DWH : Оперативные изменения сущностей\nв единый загрузочный слой
LAKE --> DWH : Подготовленная история и повторные загрузки\nв тот же загрузочный слой
DWH --> BI : Проверенные витрины\nи согласованные показатели

AIRFLOW ..> LAKE : Оркестрация пакетной обработки\nистории бизнес-сущностей
AIRFLOW ..> DWH : Оркестрация загрузок,\nсверок и формирования витрин
DQ ..> LAKE : Проверка схем, полноты\nи качества исходных данных
DQ ..> DWH : Проверка связей сущностей\nи сверка финансовых данных

HUB ..> MDM : Сбор метаданных\nсущности Клиент
HUB ..> RDM : Сбор метаданных продуктов,\nтарифов, услуг и справочников
HUB ..> LAKE : Сбор метаданных\nи происхождения исторических данных
HUB ..> DWH : Сбор метаданных\nи происхождения витрин
HUB ..> BI : Связь показателей\nс сущностями и источниками

legend bottom
  Внутри компонентов указаны обрабатываемые бизнес-сущности.
  Наличие сущности в компоненте не всегда означает мастерство.
  Сплошные стрелки — обмен данными и вызовы API.
  Пунктирные стрелки — оркестрация, проверки и сбор метаданных.
  FU / RB — системы двух банков; мастер определяется для каждой записи.
endlegend

@enduml